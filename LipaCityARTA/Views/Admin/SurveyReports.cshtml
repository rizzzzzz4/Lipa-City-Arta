@model LipaCityARTA.ViewModels.SurveyReportsViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Survey Reports";

    var responses = Model.Surveys ?? new List<LipaCityARTA.Models.SurveyResponse>();
}

<link rel="stylesheet" href="~/css/admin-survey-reports.css" />

<div class="sr-page">

    <div class="sr-header">
        <div class="sr-header-text">
            <p class"="sr-eyebrow">Admin</p>
            <h1>Survey Reports</h1>
        </div>
    </div>
    <div class="sr-kpi-grid">

        <div class="sr-kpi-card">
            <div class="sr-kpi-label">Total Responses</div>
            <div class="sr-kpi-value" id="kpiTotal">0</div>
        </div>

        <div class="sr-kpi-card">
            <div class="sr-kpi-label">Average Age</div>
            <div class="sr-kpi-value" id="kpiAvgAge">0</div>
        </div>

        <div class="sr-kpi-card">
            <div class="sr-kpi-label">Overall SQD (Survey Quality Dimension)</div>
            <div class="sr-kpi-value" id="kpiOverallSQD">0</div>
        </div>

        <div class="sr-kpi-card">
            <div class="sr-kpi-label">Top Office</div>
            <div class="sr-kpi-value" id="kpiTopOffice">-</div>
        </div>

    </div>

    <div class="sr-card sr-filters">

        <select name="office">
            <option value="">All Offices</option>
            @foreach (var o in Model.AllSurveys
                .Select(x => x.Office)
                .Where(x => !string.IsNullOrEmpty(x))
                .Distinct()
                .OrderBy(x => x))
            {
                <option value="@o">@o</option>
            }
        </select>

        <input type="date" name="dateFrom" />
        <input type="date" name="dateTo" />

        <button type="button" id="applyBtn" class="sr-btn sr-btn-primary">Apply</button>

        <a href="@Url.Action("SurveyReports")" class="sr-btn sr-btn-secondary">Reset</a>

        <button id="generateSurveyReportBtn" class="btn btn-danger">
            Generate Report
        </button>

    </div>

    <div class="sr-card"><canvas id="sqdChart"></canvas></div>
    <div class="sr-card"><canvas id="sexChart"></canvas></div>
    <div class="sr-card"><canvas id="clientChart"></canvas></div>
    <div class="sr-card"><canvas id="officeChart"></canvas></div>

    <div class="sr-card">

        <table class="sr-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Office</th>
                    <th>Age</th>
                    <th>Sex</th>
                    <th>Client</th>
                    <th>Service Quality Dimensions Average</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in responses)
                {
                    var avg = new[] { s.SQD0, s.SQD1, s.SQD2, s.SQD3, s.SQD4, s.SQD5, s.SQD6, s.SQD7, s.SQD8 }.Average();

                    <tr>
                        <td>#@s.Id</td>
                        <td>@s.Office</td>
                        <td>@s.Age</td>
                        <td>@s.Sex</td>
                        <td>@s.ClientType</td>
                        <td>@avg.ToString("0.00")</td>
                        <td>@s.DateSubmitted.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">

            <a href="@Url.Action("SurveyReports", new { page = Model.CurrentPage - 1 })" class="page-btn">Prev</a>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("SurveyReports", new { page = i })"
                       class="page-btn @(i == Model.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            <a href="@Url.Action("SurveyReports", new { page = Model.CurrentPage + 1 })" class="page-btn">Next</a>

        </div>

    </div>

</div>

<script id="surveyData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.AllSurveys.Select(s => new
        {
            age = s.Age,
            sex = s.Sex ?? "",
            client = s.ClientType ?? "",
            office = s.Office ?? "",
            date = s.DateSubmitted.ToString("yyyy-MM-dd"),

            sqd0 = (int?)s.SQD0 ?? 0,
            sqd1 = (int?)s.SQD1 ?? 0,
            sqd2 = (int?)s.SQD2 ?? 0,
            sqd3 = (int?)s.SQD3 ?? 0,
            sqd4 = (int?)s.SQD4 ?? 0,
            sqd5 = (int?)s.SQD5 ?? 0,
            sqd6 = (int?)s.SQD6 ?? 0,
            sqd7 = (int?)s.SQD7 ?? 0,
            sqd8 = (int?)s.SQD8 ?? 0
        })
    ))
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin-surveyreports.js"></script>
}