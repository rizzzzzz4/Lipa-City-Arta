@model LipaCityARTA.ViewModels.ComplaintListViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Complaints";

    var complaints = Model.Complaints ?? new List<LipaCityARTA.Models.Complaint>();
    int overdueDays = 3;

    string EffectiveStatus(LipaCityARTA.Models.Complaint c)
    {
        var status = (c.Status ?? "Pending").Trim();

        if (status != "Resolved" &&
            status != "Escalated" &&
            c.DateSubmitted <= DateTime.Now.AddDays(-overdueDays))
        {
            return "Overdue";
        }

        return status;
    }

    var pendingComplaints = complaints
        .Where(c => EffectiveStatus(c) == "Pending")
        .ToList();

    var inProgressComplaints = complaints
        .Where(c =>
            EffectiveStatus(c) == "In Progress" ||
            EffectiveStatus(c) == "Overdue" ||
            EffectiveStatus(c) == "Escalated")
        .ToList();

    var resolvedComplaints = complaints
        .Where(c => EffectiveStatus(c) == "Resolved")
        .ToList();
}

<link rel="stylesheet" href="@Url.Content("~/css/admin-complaints.css")" />

<div class="c-page">

    <div class="c-header">
        <div class="c-header-text">
            <p class="c-eyebrow">Admin Operations</p>
            <h1>Complaints Management</h1>
            <p class="c-subtitle">
                Track complaint submissions, monitor workflow status, and manage pending, active, and resolved cases.
            </p>
        </div>

        <div class="c-header-meta">
            <div class="c-meta-card">
                <span>Board Summary</span>
                <strong id="boardSummaryCount">@complaints.Count complaint records</strong>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }

    <div class="c-toolbar-card">
        <div class="c-toolbar">

            <div class="c-search-wrap">
                <label for="complaintSearch">Search</label>
                <input id="complaintSearch" placeholder="Search complaints..." />
            </div>

            <div class="c-filter">
                <label>Office</label>
                <select id="filterOffice">
                    <option value="">All</option>
                    @foreach (var office in complaints
                                        .Where(c => !string.IsNullOrWhiteSpace(c.Office))
                                        .Select(c => c.Office)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@office">@office</option>
                    }
                </select>
            </div>

            <div class="c-filter">
                <label>Client Type</label>
                <select id="filterClient">
                    <option value="">All</option>
                    @foreach (var type in complaints
                                        .Where(c => !string.IsNullOrWhiteSpace(c.ClientType))
                                        .Select(c => c.ClientType)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="c-filter">
                <label>From Date</label>
                <input type="date" id="filterFromDate" />
            </div>

            <div class="c-filter">
                <label>To Date</label>
                <input type="date" id="filterToDate" />
            </div>

            <button type="button" id="applyFiltersBtn" class="c-filter-btn">
                Apply Filters
            </button>

            <button type="button" id="generateReportBtn" class="c-export-btn">
                Generate Report
            </button>

        </div>
    </div>

    <div class="c-kpi-grid">
        <div class="c-kpi-card">
            <div class="c-k-title">Open</div>
            <div class="c-k-value c-open" id="openCount">@Model.OpenCount</div>
            <div class="c-k-sub">Complaints awaiting completion</div>
        </div>

        <div class="c-kpi-card">
            <div class="c-k-title">Overdue</div>
            <div class="c-k-value c-overdue" id="overdueCount">@Model.OverdueCount</div>
            <div class="c-k-sub">Cases needing urgent attention</div>
        </div>

        <div class="c-kpi-card">
            <div class="c-k-title">New Complaints</div>
            <div class="c-k-value" id="newComplaintsCount">@Model.NewComplaints</div>
            <div class="c-k-sub">Recently submitted complaints</div>
        </div>

        <div class="c-kpi-card">
            <div class="c-k-title">Resolved</div>
            <div class="c-k-value c-resolved" id="resolvedCount">@Model.ResolvedCount</div>
            <div class="c-k-sub">Cases already completed</div>
        </div>

        <div class="c-kpi-card">
            <div class="c-k-title">Backlog Average</div>
            <div class="c-k-value" id="backlogCount">@Model.BacklogAvg</div>
            <div class="c-k-sub">Average pending complaint load</div>
        </div>
    </div>

    <div class="c-tabs-card">
        <div class="c-tabs-header">
            <button type="button" class="c-tab-btn active" data-tab="pendingTab">
                Pending <span id="pendingTabCount">@pendingComplaints.Count</span>
            </button>
            <button type="button" class="c-tab-btn" data-tab="progressTab">
                In Progress <span id="progressTabCount">@inProgressComplaints.Count</span>
            </button>
            <button type="button" class="c-tab-btn" data-tab="resolvedTab">
                Resolved <span id="resolvedTabCount">@resolvedComplaints.Count</span>
            </button>
        </div>

        <div class="c-tab-panel active" id="pendingTab">
            <div class="c-tab-panel-head c-tab-pending">
                <div>
                    <h3>Pending Complaints</h3>
                    <p>Awaiting initial action</p>
                </div>
            </div>

            @if (pendingComplaints.Any())
            {
                <div class="c-table-wrap">
                    <table class="c-main-table">
                        <thead>
                            <tr>
                                <th>Tracking ID</th>
                                <th>Office</th>
                                <th>Client Type</th>
                                <th>Reason</th>
                                <th>Message</th>
                                <th>Email</th>
                                <th>Date Submitted</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in pendingComplaints)
                            {
                                var effectiveStatus = EffectiveStatus(item);
                                var shortReason = !string.IsNullOrWhiteSpace(item.Reason) && item.Reason.Length > 40
                                ? item.Reason.Substring(0, 40) + "..."
                                : item.Reason;

                                var shortMessage = !string.IsNullOrWhiteSpace(item.Message) && item.Message.Length > 50
                                ? item.Message.Substring(0, 50) + "..."
                                : item.Message;

                                var latestAction = item.ActionHistories?
                                .OrderByDescending(h => h.CreatedAt)
                                .FirstOrDefault();

                                <tr class="c-ticket"
                                    data-id="@item.Id"
                                    data-tabgroup="pending"
                                    data-trackingid="@item.TrackingId"
                                    data-office="@item.Office"
                                    data-clienttype="@item.ClientType"
                                    data-reason="@item.Reason"
                                    data-message="@item.Message"
                                    data-email="@item.Email"
                                    data-status="@effectiveStatus"
                                    data-date="@item.DateSubmitted.ToString("yyyy-MM-dd")"
                                    data-isclosed="@item.IsCaseClosed.ToString().ToLower()"
                                    data-resolvedat="@(item.ResolvedAt.HasValue? item.ResolvedAt.Value.ToString("MMM dd, yyyy hh:mm tt") : "")"
                                    data-latestaction="@(latestAction?.ActionNote ?? "")">

                                    <td><span class="c-track-id">@item.TrackingId</span></td>
                                    <td>@item.Office</td>
                                    <td>@item.ClientType</td>
                                    <td title="@item.Reason">@shortReason</td>
                                    <td title="@item.Message">@shortMessage</td>
                                    <td>@item.Email</td>
                                    <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                    <td class="c-action-cell">
                                        <div class="c-table-actions">
                                            <button type="button" class="c-view-btn js-view-complaint">View</button>

                                            <button type="button"
                                                    class="c-start-btn js-open-workflow"
                                                    data-id="@item.Id"
                                                    data-trackingid="@item.TrackingId"
                                                    data-office="@item.Office"
                                                    data-email="@item.Email"
                                                    data-status="@effectiveStatus"
                                                    data-isclosed="@item.IsCaseClosed.ToString().ToLower()">
                                                Start
                                            </button>
                                        </div>

                                        <div class="c-history-data" aria-hidden="true">
                                            @if (item.ActionHistories != null && item.ActionHistories.Any())
                                            {
                                                foreach (var history in item.ActionHistories.OrderByDescending(h => h.CreatedAt))
                                                {
                                                    <div class="c-history-entry">
                                                        <strong>@history.StatusAtThatTime</strong> - @history.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")<br />
                                                        @history.ActionNote
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="c-history-entry">No action history yet.</div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="c-empty-panel">No pending complaints.</div>
            }
        </div>

        <div class="c-tab-panel" id="progressTab">
            <div class="c-tab-panel-head c-tab-progress">
                <div>
                    <h3>In Progress Complaints</h3>
                    <p>Currently being handled</p>
                </div>
            </div>

            @if (inProgressComplaints.Any())
            {
                <div class="c-table-wrap">
                    <table class="c-main-table">
                        <thead>
                            <tr>
                                <th>Tracking ID</th>
                                <th>Office</th>
                                <th>Client Type</th>
                                <th>Reason</th>
                                <th>Message</th>
                                <th>Status</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in inProgressComplaints)
                            {
                                var s = EffectiveStatus(item);

                                var statusClass =
                                s == "Escalated" ? "c-st-escalated" :
                                s == "Overdue" ? "c-st-overdue" :
                                                        "c-st-inprogress";

                                var shortReason = !string.IsNullOrWhiteSpace(item.Reason) && item.Reason.Length > 40
                                ? item.Reason.Substring(0, 40) + "..."
                                : item.Reason;

                                var shortMessage = !string.IsNullOrWhiteSpace(item.Message) && item.Message.Length > 50
                                ? item.Message.Substring(0, 50) + "..."
                                : item.Message;

                                var latestAction = item.ActionHistories?
                                .OrderByDescending(h => h.CreatedAt)
                                .FirstOrDefault();

                                <tr class="c-ticket"
                                    data-id="@item.Id"
                                    data-tabgroup="progress"
                                    data-trackingid="@item.TrackingId"
                                    data-office="@item.Office"
                                    data-clienttype="@item.ClientType"
                                    data-reason="@item.Reason"
                                    data-message="@item.Message"
                                    data-email="@item.Email"
                                    data-status="@s"
                                    data-date="@item.DateSubmitted.ToString("yyyy-MM-dd")"
                                    data-isclosed="@item.IsCaseClosed.ToString().ToLower()"
                                    data-resolvedat="@(item.ResolvedAt.HasValue? item.ResolvedAt.Value.ToString("MMM dd, yyyy hh:mm tt") : "")"
                                    data-latestaction="@(latestAction?.ActionNote ?? "")">

                                    <td><span class="c-track-id">@item.TrackingId</span></td>
                                    <td>@item.Office</td>
                                    <td>@item.ClientType</td>
                                    <td title="@item.Reason">@shortReason</td>
                                    <td title="@item.Message">@shortMessage</td>
                                    <td><span class="c-status @statusClass">@s</span></td>
                                    <td>@item.Email</td>
                                    <td class="c-action-cell">
                                        <div class="c-table-actions">
                                            <button type="button" class="c-view-btn js-view-complaint">View</button>

                                            <button type="button"
                                                    class="c-mini-btn js-open-workflow"
                                                    data-id="@item.Id"
                                                    data-trackingid="@item.TrackingId"
                                                    data-office="@item.Office"
                                                    data-email="@item.Email"
                                                    data-status="@s"
                                                    data-isclosed="@item.IsCaseClosed.ToString().ToLower()">
                                                Update
                                            </button>
                                        </div>

                                        <div class="c-history-data" aria-hidden="true">
                                            @if (item.ActionHistories != null && item.ActionHistories.Any())
                                            {
                                                foreach (var history in item.ActionHistories.OrderByDescending(h => h.CreatedAt))
                                                {
                                                    <div class="c-history-entry">
                                                        <strong>@history.StatusAtThatTime</strong> - @history.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")<br />
                                                        @history.ActionNote
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="c-history-entry">No action history yet.</div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="c-empty-panel">No complaints in progress.</div>
            }
        </div>

        <div class="c-tab-panel" id="resolvedTab">
            <div class="c-tab-panel-head c-tab-resolved">
                <div>
                    <h3>Resolved Complaints</h3>
                    <p>Completed complaint cases</p>
                </div>
            </div>

            @if (resolvedComplaints.Any())
            {
                <div class="c-table-wrap">
                    <table class="c-main-table">
                        <thead>
                            <tr>
                                <th>Tracking ID</th>
                                <th>Office</th>
                                <th>Client Type</th>
                                <th>Reason</th>
                                <th>Message</th>
                                <th>Email</th>
                                <th>Date Submitted</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in resolvedComplaints)
                            {
                                var effectiveStatus = EffectiveStatus(item);

                                var shortReason = !string.IsNullOrWhiteSpace(item.Reason) && item.Reason.Length > 40
                                ? item.Reason.Substring(0, 40) + "..."
                                : item.Reason;

                                var shortMessage = !string.IsNullOrWhiteSpace(item.Message) && item.Message.Length > 50
                                ? item.Message.Substring(0, 50) + "..."
                                : item.Message;

                                var latestAction = item.ActionHistories?
                                .OrderByDescending(h => h.CreatedAt)
                                .FirstOrDefault();

                                <tr class="c-ticket"
                                    data-id="@item.Id"
                                    data-tabgroup="resolved"
                                    data-trackingid="@item.TrackingId"
                                    data-office="@item.Office"
                                    data-clienttype="@item.ClientType"
                                    data-reason="@item.Reason"
                                    data-message="@item.Message"
                                    data-email="@item.Email"
                                    data-status="@effectiveStatus"
                                    data-date="@item.DateSubmitted.ToString("yyyy-MM-dd")"
                                    data-isclosed="@item.IsCaseClosed.ToString().ToLower()"
                                    data-resolvedat="@(item.ResolvedAt.HasValue? item.ResolvedAt.Value.ToString("MMM dd, yyyy hh:mm tt") : "")"
                                    data-latestaction="@(latestAction?.ActionNote ?? "")">

                                    <td><span class="c-track-id">@item.TrackingId</span></td>
                                    <td>@item.Office</td>
                                    <td>@item.ClientType</td>
                                    <td title="@item.Reason">@shortReason</td>
                                    <td title="@item.Message">@shortMessage</td>
                                    <td>@item.Email</td>
                                    <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                    <td class="c-action-cell">
                                        <div class="c-table-actions">
                                            <button type="button" class="c-view-btn js-view-complaint">View</button>
                                            <span class="c-done">Done</span>
                                        </div>

                                        <div class="c-history-data" aria-hidden="true">
                                            @if (item.ActionHistories != null && item.ActionHistories.Any())
                                            {
                                                foreach (var history in item.ActionHistories.OrderByDescending(h => h.CreatedAt))
                                                {
                                                    <div class="c-history-entry">
                                                        <strong>@history.StatusAtThatTime</strong> - @history.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")<br />
                                                        @history.ActionNote
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="c-history-entry">No action history yet.</div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="c-empty-panel">No resolved complaints.</div>
            }
        </div>
    </div>

    <div id="complaintModal" class="c-modal">
        <div class="c-modal-box">
            <div class="c-modal-head">
                <h3>Complaint Details</h3>
                <button type="button" class="c-modal-close" id="closeComplaintModal">×</button>
            </div>

            <div class="c-modal-body">
                <div class="c-info-grid">
                    <div class="c-info-item">
                        <span class="c-info-label">Tracking ID</span>
                        <strong id="mTrackingId"></strong>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Office</span>
                        <strong id="mOffice"></strong>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Client Type</span>
                        <strong id="mClientType"></strong>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Email</span>
                        <strong id="mEmail"></strong>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Status</span>
                        <span id="mStatus"></span>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Date Submitted</span>
                        <strong id="mDate"></strong>
                    </div>
                </div>

                <div class="c-info-stack">
                    <div class="c-info-block">
                        <span class="c-info-label">Reason / Issue</span>
                        <p id="mReason" class="c-info-text"></p>
                    </div>

                    <div class="c-info-block">
                        <span class="c-info-label">Message</span>
                        <p id="mMessage" class="c-info-text"></p>
                    </div>

                    <div class="c-info-block">
                        <span class="c-info-label">Latest Action</span>
                        <p id="mLatestAction" class="c-info-text"></p>
                    </div>
                </div>

                <div class="c-info-grid">
                    <div class="c-info-item">
                        <span class="c-info-label">Case Closed</span>
                        <strong id="mIsClosed"></strong>
                    </div>
                    <div class="c-info-item">
                        <span class="c-info-label">Resolved At</span>
                        <strong id="mResolvedAt"></strong>
                    </div>
                </div>

                <div class="c-history-card">
                    <div class="c-history-head">
                        <h4>Action History</h4>
                    </div>
                    <div id="mActionHistory" class="c-history-list"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="workflowModal" class="c-modal">
        <div class="c-modal-box c-workflow-modal">
            <div class="c-modal-head">
                <div>
                    <h3>Update Complaint Workflow</h3>
                    <p class="c-modal-subtext">Document actions taken and update the complaint status properly.</p>
                </div>
                <button type="button" class="c-modal-close" id="closeWorkflowModal">×</button>
            </div>

            <form asp-controller="Admin" asp-action="UpdateComplaintStatus" method="post" id="workflowForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="wfId" />

                <div class="c-modal-body c-workflow-body">

                    <div class="c-workflow-top">
                        <div class="c-info-card">
                            <h4>Complaint Information</h4>

                            <div class="c-info-grid">
                                <div class="c-info-item">
                                    <span class="c-info-label">Tracking ID</span>
                                    <strong id="wfTrackingId"></strong>
                                </div>

                                <div class="c-info-item">
                                    <span class="c-info-label">Office</span>
                                    <strong id="wfOffice"></strong>
                                </div>

                                <div class="c-info-item">
                                    <span class="c-info-label">Email</span>
                                    <strong id="wfEmail"></strong>
                                </div>

                                <div class="c-info-item">
                                    <span class="c-info-label">Current Status</span>
                                    <span id="wfCurrentStatusBadge" class="c-status-badge">Pending</span>
                                </div>
                            </div>

                            <div class="c-info-stack">
                                <div class="c-info-block">
                                    <span class="c-info-label">Reason / Issue</span>
                                    <p id="wfReason" class="c-info-text"></p>
                                </div>

                                <div class="c-info-block">
                                    <span class="c-info-label">Message</span>
                                    <p id="wfMessage" class="c-info-text"></p>
                                </div>
                            </div>
                        </div>

                        <div class="c-update-card">
                            <h4>Workflow Update</h4>

                            <div class="c-form-row">
                                <label for="wfStatus"><strong>Update Status To</strong></label>
                                <select name="status" id="wfStatus" class="c-input c-status-select">
                                    <option value="In Progress">In Progress</option>
                                    <option value="Resolved">Resolved</option>
                                </select>

                                <p class="c-field-help">
                                    Select <strong>In Progress</strong> to add another action/update while the complaint is still being handled.
                                    Select <strong>Resolved</strong> only when the case is confirmed closed.
                                </p>

                                <div id="wfStatusHint" class="c-status-hint c-status-hint-progress">
                                    The complaint will remain active and the new action note will be added to its history.
                                </div>
                            </div>

                            <div class="c-form-row">
                                <label for="wfActionNote"><strong>New Action Note</strong></label>
                                <textarea name="adminActionNote"
                                          id="wfActionNote"
                                          class="c-input c-note-textarea"
                                          rows="5"
                                          placeholder="Enter a new action taken by admin..."></textarea>
                            </div>

                            <div class="c-confirm-box">
                                <label class="c-confirm-check">
                                    <input type="checkbox" id="wfIsClosed" />
                                    <span>Confirm case is closed</span>
                                </label>

                                <input type="hidden" name="isCaseClosed" id="wfIsClosedHidden" value="false" />

                                <p class="c-confirm-help">
                                    This must be checked before the complaint can be marked as resolved.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="c-history-card">
                        <div class="c-history-head">
                            <h4>Action History</h4>
                            <span class="c-history-sub">All previous actions remain saved for documentation.</span>
                        </div>

                        <div id="wfActionHistory" class="c-history-list"></div>
                    </div>
                </div>

                <div class="c-modal-foot c-workflow-foot">
                    <button type="button" class="c-secondary-btn" id="cancelWorkflowModal">Cancel</button>
                    <button type="submit" class="c-filter-btn">Save Action Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <script src="~/js/admin-complaints.js"></script>
}