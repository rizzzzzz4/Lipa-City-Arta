@model LipaCityARTA.ViewModels.AnalyticsDashboardViewModel
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Analytics Reports";
}

<link rel="stylesheet" href="@Url.Content("~/css/admin-analytics.css")" />

<div class="ar-page">

    <div class="ar-header">
        <div class="ar-header-text">
            <p class="ar-eyebrow">Admin Analytics</p>
            <h1>Analytics Reports</h1>
        </div>

        <div class="ar-header-meta">
            <div class="ar-meta-card">
                <span>Selected Range</span>
                <strong>@Model.From.ToString("MMM dd, yyyy") - @Model.To.ToString("MMM dd, yyyy")</strong>
            </div>
        </div>
    </div>

    <div class="ar-filter-card">
        <form id="analyticsFilterForm"
              method="get"
              asp-controller="Admin"
              asp-action="AnalyticsReports"
              class="ar-filters">

            <div class="ar-field">
                <label for="from">From</label>
                <input type="date"
                       id="from"
                       name="from"
                       value="@Model.From.ToString("yyyy-MM-dd")" />
            </div>

            <div class="ar-field">
                <label for="to">To</label>
                <input type="date"
                       id="to"
                       name="to"
                       value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>

            <div class="ar-field">
                <label for="office">Office</label>
                <select id="office" name="office">
                    @if (string.IsNullOrWhiteSpace(Model.Office))
                    {
                        <option value="" selected>All Offices</option>
                    }
                    else
                    {
                        <option value="">All Offices</option>
                    }

                    @foreach (var office in (Model.Offices ?? new List<string>()))
                    {
                        if (Model.Office == office)
                        {
                            <option value="@office" selected>@office</option>
                        }
                        else
                        {
                            <option value="@office">@office</option>
                        }
                    }
                </select>
            </div>

            <div class="ar-actions">
                <button type="button" id="generateAnalyticsReportBtn" class="ar-btn-report">
                    Generate Report
                </button>

                <button type="submit" id="applyFiltersBtn" class="ar-btn-filter">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <div class="ar-kpi-grid">
        <div class="ar-kpi-card">
            <div class="ar-k-title">Total Records</div>
            <div class="ar-k-value">@((Model.TotalSurveys + Model.TotalComplaints).ToString())</div>
        </div>

        <div class="ar-kpi-card">
            <div class="ar-k-title">Total Surveys</div>
            <div class="ar-k-value">@Model.TotalSurveys</div>
        </div>

        <div class="ar-kpi-card">
            <div class="ar-k-title">Total Complaints</div>
            <div class="ar-k-value">@Model.TotalComplaints</div>
        </div>

        <div class="ar-kpi-card">
            <div class="ar-k-title">Avg Satisfaction</div>
            <div class="ar-k-value">@Model.AvgSatisfaction.ToString("0.00")</div>
            <div class="ar-k-sub">Average score from 1 to 5</div>
        </div>
    </div>

    <div class="ar-grid ar-grid-main">

        <div class="ar-card">
            <div class="ar-card-h">
                <div>
                    <h3>Activity Trend</h3>
                    <p>Survey satisfaction and complaint volume over time.</p>
                </div>
            </div>
            <div class="ar-card-b">
                <div class="ar-chart-wrap">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="ar-card">
            <div class="ar-card-h">
                <div>
                    <h3>Office-to-Office Comparison</h3>
                    <p>Complaint volume versus satisfaction score per office.</p>
                </div>
            </div>
            <div class="ar-card-b">
                <div class="ar-chart-wrap">
                    <canvas id="officeChart"></canvas>
                </div>

                <div class="ar-note">
                    Complaint volume and satisfaction score are shown as horizontal bars for easier office comparison.
                </div>
            </div>
        </div>

        <div class="ar-card">
            <div class="ar-card-h">
                <div>
                    <h3>Service Quality Dimension Scores</h3>
                    <p>Average rating for each SQD indicator.</p>
                </div>
            </div>
            <div class="ar-card-b">
                <div class="ar-chart-wrap">
                    <canvas id="sqdChart"></canvas>
                </div>

                <div class="ar-note">
                    Higher scores indicate better perceived service quality.
                </div>

                <div class="sqd-guide">
                    <h4>SQD Guide</h4>
                    <ul>
                        <li><strong>SQD0</strong> - I am satisfied with the service that I availed.</li>
                        <li><strong>SQD1</strong> - I spent a reasonable amount of time for my transaction.</li>
                        <li><strong>SQD2</strong> - The office followed the transaction's requirements and steps based on the information provided.</li>
                        <li><strong>SQD3</strong> - The steps, (including payment),I needed to do for my transaction were easy and simple.</li>
                        <li><strong>SQD4</strong> - I easily found information about my transaction from the office or its website.</li>
                        <li><strong>SQD5</strong> - I paid a reasonable amount of fees for my transaction.</li>
                        <li><strong>SQD6</strong> - I feel the office was fair to everyone, or <i>"walang palakasan"</i>, during my transaction.</li>
                        <li><strong>SQD7</strong> - I was treated courteously by the staff, and (if asked for help) the staff was helpful.</li>
                        <li><strong>SQD8</strong> - I got what i needed from the government office, or (if denied) denial of request was sufficiently explained to me.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="ar-card">
            <div class="ar-card-h">
                <div>
                    <h3>Top / Bottom Performance</h3>
                    <p>Quick office and question-level insights.</p>
                </div>
            </div>
            <div class="ar-card-b">
                <div class="ar-list-block">

                    <div class="ar-list-card">
                        <b>Top Offices (Satisfaction)</b>
                        <ul class="ar-list">
                            @foreach (var x in Model.TopOffices ?? new List<LipaCityARTA.ViewModels.OfficeMetric>())
                            {
                                <li>@x.Office — @x.Score.ToString("0.00")</li>
                            }
                        </ul>
                    </div>

                    <div class="ar-list-card">
                        <b>Bottom Offices (Satisfaction)</b>
                        <ul class="ar-list">
                            @foreach (var x in Model.BottomOffices ?? new List<LipaCityARTA.ViewModels.OfficeMetric>())
                            {
                                <li>@x.Office — @x.Score.ToString("0.00")</li>
                            }
                        </ul>
                    </div>

                    <div class="ar-list-card">
                        <b>Lowest Survey Questions</b>
                        <ul class="ar-list">
                            @foreach (var q in Model.LowestQuestions ?? new List<LipaCityARTA.ViewModels.QuestionMetric>())
                            {
                                <li>@q.Question — @q.Score.ToString("0.00")</li>
                            }
                        </ul>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<script type="application/json" id="officesJson">
    @Html.Raw(JsonSerializer.Serialize(Model.Offices ?? new List<string>()))
</script>

<script type="application/json" id="officeSatJson">
    @Html.Raw(JsonSerializer.Serialize(Model.OfficeSatisfaction ?? new List<double>()))
</script>

<script type="application/json" id="officeCmpJson">
    @Html.Raw(JsonSerializer.Serialize(Model.OfficeComplaints ?? new List<int>()))
</script>

<script type="application/json" id="trendLabelsJson">
    @Html.Raw(JsonSerializer.Serialize(Model.Labels ?? new List<string>()))
</script>

<script type="application/json" id="trendSatJson">
    @Html.Raw(JsonSerializer.Serialize(Model.SatisfactionTrend ?? new List<double>()))
</script>

<script type="application/json" id="trendCmpJson">
    @Html.Raw(JsonSerializer.Serialize(Model.ComplaintTrend ?? new List<int>()))
</script>

<script type="application/json" id="sqdLabelsJson">
    @Html.Raw(JsonSerializer.Serialize(Model.SQDLabels ?? new List<string>()))
</script>

<script type="application/json" id="sqdScoresJson">
    @Html.Raw(JsonSerializer.Serialize(Model.SQDScores ?? new List<double>()))
</script>

<script type="application/json" id="topOfficesJson">
    @Html.Raw(JsonSerializer.Serialize(Model.TopOffices ?? new List<LipaCityARTA.ViewModels.OfficeMetric>()))
</script>

<script type="application/json" id="bottomOfficesJson">
    @Html.Raw(JsonSerializer.Serialize(Model.BottomOffices ?? new List<LipaCityARTA.ViewModels.OfficeMetric>()))
</script>

<script type="application/json" id="lowestQuestionsJson">
    @Html.Raw(JsonSerializer.Serialize(Model.LowestQuestions ?? new List<LipaCityARTA.ViewModels.QuestionMetric>()))
</script>

<script type="application/json" id="reportMetaJson">
    @Html.Raw(JsonSerializer.Serialize(new
    {
        selectedOffice = Model.Office ?? "All Offices",
        fromText = Model.From.ToString("MMMM dd, yyyy"),
        toText = Model.To.ToString("MMMM dd, yyyy"),
        totalSurveys = Model.TotalSurveys,
        totalComplaints = Model.TotalComplaints,
        avgSatisfaction = Model.AvgSatisfaction.ToString("0.00")
    }))
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <script src="~/js/admin-analyticsreports.js"></script>
}