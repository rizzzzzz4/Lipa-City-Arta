@model LipaCityARTA.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var totalOfficeResponses = Model.OfficeBreakdown?.Sum(o => o.Count) ?? 0;
    var officeCount = Model.OfficeBreakdown?.Count() ?? 0;
    var topOffice = !string.IsNullOrWhiteSpace(Model.MostVisitedOffice)
        ? Model.MostVisitedOffice
        : "No data available";

    var overallAvgSqd = (Model.AvgSQDs != null && Model.AvgSQDs.Any())
        ? Model.AvgSQDs.Average()
        : 0;
}

<link rel="stylesheet" href="@Url.Content("~/css/admin-dashboard.css")" />

<div class="dashboard-container">

    <div class="dashboard-header">
        <div class="dashboard-header-text">
            <p class="dashboard-eyebrow">Admin Overview</p>
            <h1>Dashboard</h1>
        </div>

        <div class="dashboard-header-meta">
            <div class="meta-card">
                <span class="meta-label">Last Updated</span>
                <strong>@DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")</strong>
            </div>
        </div>
    </div>

    <div class="dashboard-main">
        <div class="dashboard-card">
            <h3>Total Submissions</h3>
            <p class="stat-number">@Model.TotalSubmissions</p>
        </div>

        <div class="dashboard-card">
            <h3>Total Surveys</h3>
            <p class="stat-number">@Model.TotalSurveys</p>
        </div>

        <div class="dashboard-card">
            <h3>Total Complaints</h3>
            <p class="stat-number">@Model.TotalComplaints</p>
        </div>

        <div class="dashboard-card">
            <h3>Active Users</h3>
            <p class="stat-number">@Model.ActiveUsers</p>
        </div>

        <div class="dashboard-card warning-card">
            <h3>Pending Complaints</h3>
            <p class="stat-number">@Model.PendingComplaints</p>
            <p class="card-note">Complaints awaiting action</p>
        </div>
    </div>

    <div class="insights-grid">
        <div class="insight-card">
            <div>
                <p class="insight-label">Most Active Office</p>
                <h3 class="insight-title">@topOffice</h3>
            </div>
            <div class="insight-badge">Top Office</div>
        </div>

        <div class="insight-card">
            <div>
                <p class="insight-label">Overall Average SQD</p>
                <h3 class="insight-title">@overallAvgSqd.ToString("0.00") / 5.00</h3>
            </div>
            <div class="insight-badge">Quality Score</div>
        </div>

        <div class="insight-card">
            <div>
                <p class="insight-label">Offices with Responses</p>
                <h3 class="insight-title">@officeCount</h3>
            </div>
            <div class="insight-badge">Coverage</div>
        </div>
    </div>

    <div class="card card-large mt-4">
        <div class="card-header">
            <div>
                <h3 class="section-title">Survey Responses Breakdown by Office</h3>
                <p class="section-subtitle">Distribution of submitted surveys across all participating offices.</p>
            </div>
            <div class="card-header-stat">
                <span>Total Responses</span>
                <strong>@totalOfficeResponses</strong>
            </div>
        </div>

        <canvas id="officePieChart"></canvas>
    </div>

    <div class="charts-grid mt-4">
        <div class="card chart-card">
            <div class="card-header">
                <div>
                    <h3 class="section-title">Average SQD Ratings</h3>
                    <p class="section-subtitle">Average rating for each service quality dimension.</p>
                </div>
            </div>
            <canvas id="avgSQDChart"></canvas>
        </div>

        <div class="card chart-card">
            <div class="card-header">
                <div>
                    <h3 class="section-title">Survey Submission Trend</h3>
                    <p class="section-subtitle">Survey activity over time based on recorded submissions.</p>
                </div>
            </div>
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <div>
                <h3 class="section-title">Recent Complaints</h3>
                <p class="section-subtitle">Latest complaint entries received by the system.</p>
            </div>
        </div>

        @if (Model.RecentComplaints != null && Model.RecentComplaints.Any())
        {
            <ul class="recent-list">
                @foreach (var complaint in Model.RecentComplaints)
                {
                    <li>
                        <div class="recent-main">
                            <strong>@complaint.Reason</strong>
                            <p>
                                @(string.IsNullOrWhiteSpace(complaint.Office) ? "Office not specified" : complaint.Office)
                            </p>
                        </div>

                        <div class="recent-meta">
                            <span class="status-badge @(complaint.Status?.ToLower() == "resolved" ? "resolved" : "pending")">
                                @(string.IsNullOrWhiteSpace(complaint.Status) ? "Pending" : complaint.Status)
                            </span>
                            <small>@complaint.DateSubmitted.ToString("MMM dd, yyyy")</small>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state">
                <h4>No recent complaints yet</h4>
                <p>New complaint submissions will appear here once records are added.</p>
            </div>
        }
    </div>

</div>

<script type="application/json" id="sqdJson">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvgSQDs ?? new double[9]))
</script>

<script type="application/json" id="trendLabelsJson">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendDates ?? new List<string>()))
</script>

<script type="application/json" id="trendCountsJson">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendCounts ?? new List<int>()))
</script>

<script type="application/json" id="officeLabelsJson">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.OfficeBreakdown?.Select(o => o.Office).ToList() ?? new List<string>()
        ))
</script>

<script type="application/json" id="officeCountsJson">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.OfficeBreakdown?.Select(o => o.Count).ToList() ?? new List<int>()
        ))
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/admin-dashboard.js"></script>
}